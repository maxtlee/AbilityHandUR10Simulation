<mujoco model="ur10e grasp (hand-only policy)">
  <include file="ur10e.xml"/>

  <statistic center="-0.15 0.6 0.4" extent="0.8"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <texture type="2d" name="table_tex" builtin="flat" rgb1="0.6 0.45 0.3" width="128" height="128"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" texture="table_tex" rgba="0.6 0.45 0.3 1" specular="0.1" shininess="0.1"/>
    <material name="object_mat" rgba="0.8 0.2 0.2 1" specular="0.5" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Floor catches dropped objects so the workspace stays clean. -->
    <body name="floor_table" pos="-0.155 0.55 0">
      <geom name="table_top" type="box" size="0.15 0.10 0.02" pos="0 0 0.20"
            material="table_mat" mass="20" friction="1.0 0.005 0.0001"/>
    </body>

    <!-- Graspable object for the HOLD task: 3cm cube placed in the natural
         finger-thumb cup at half-closure (action=0 maps to MCPs at midpoint
         0.87 rad). -->
    <body name="target_object" pos="-0.176 0.586 0.507">
      <freejoint name="object_joint"/>
      <geom name="object_geom" type="box" size="0.015 0.015 0.015"
            material="object_mat" mass="0.03" friction="2.0 0.01 0.0001"
            solref="0.01 1" solimp="0.95 0.99 0.002"/>
      <site name="object_site" size="0.001"/>
    </body>

    <camera name="grasp_cam" pos="0.2 0.2 0.8" xyaxes="0.707 -0.707 0 0.354 0.354 0.866"/>
  </worldbody>

  <sensor>
    <!-- xbody returns the body frame origin, not the inertial frame -->
    <framepos  name="palm_pos"   objtype="xbody" objname="ability_hand"/>
    <framexaxis name="palm_xaxis" objtype="xbody" objname="ability_hand"/>
    <frameyaxis name="palm_yaxis" objtype="xbody" objname="ability_hand"/>
    <framezaxis name="palm_zaxis" objtype="xbody" objname="ability_hand"/>
  </sensor>

  <keyframe>
    <!-- Arm: qarm = (-1.6, -1.6, 1.8, -1.6, -1.5708, 0) puts palm at ~(-0.155, 0.645, 0.547)
         with palm normal facing +y and fingers extending -z.
         Hand: fully open (all hand joints at 0).
         Object: on table top at world (-0.155, 0.58, 0.445).
         qpos order: 6 arm + 10 hand + 7 object freejoint. -->
    <!-- HOLD task: hand qpos at the closure where fingertips are just touching
         the pre-placed object (MCPs ~0.9, thumb closed). ctrl commands TIGHTER
         closure (MCPs 1.4, thumb fully closed/opposed) so the position
         controller generates a clamping force on the object via position error
         (force = kp * (ctrl - qpos)). -->
    <!-- HOLD task initial state: hand qpos and ctrl both at the midpoints of
         each actuator's range, which is exactly what action=0 maps to in the
         env. This way the agent doesn't move the hand on its first action
         when starting from neutral. -->
    <key name="grasp_ready"
         qpos="-1.6 -1.6 1.7 -1.5 -1.5708 0
                 0.87 1.644 0.87 1.644 0.87 1.644 0.87 1.644 -1.045 0.955
                 -0.176 0.586 0.507 1 0 0 0"
         ctrl="-1.6 -1.6 1.7 -1.5 -1.5708 0
                 0.87 1.644 0.87 1.644 0.87 1.644 0.87 1.644 -1.045 0.955"/>
  </keyframe>
</mujoco>
